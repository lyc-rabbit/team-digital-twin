# ===== 硅基流动 DeepSeek API 配置 =====
# 在 https://cloud.siliconflow.cn/ 注册并获取 API Key
# 将本文件复制为 .env 并填入你的 Key

# 硅基流动 API Key（必填，不填则进入降级模式）
SILICONFLOW_API_KEY=sk-your-key-here

# API 端点（默认即可）
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# 模型配置（按场景分层）
# 事件解析用 V3（快+便宜+稳定）
DEEPSEEK_MODEL_EXTRACT=deepseek-ai/DeepSeek-V3
# 模拟推演用 R1（深度推理）
DEEPSEEK_MODEL_SIMULATE=deepseek-ai/DeepSeek-R1
# 问答用 V3
DEEPSEEK_MODEL_CHAT=deepseek-ai/DeepSeek-V3
